{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiktok-shop-video-ai.local/schemas/research.schema.json",
  "title": "Research",
  "description": "Saída do research-agent: pesquisa de produto, audiência e referências criativas.",
  "type": "object",
  "required": ["schema_version", "project_id", "created_at", "status", "product_summary", "audience", "creative_landscape"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "project_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["complete", "partial", "error"] },
    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Preenchido quando status = partial/error: o que não foi possível pesquisar."
    },
    "product_summary": {
      "type": "object",
      "required": ["pain_points_solved", "competitors"],
      "properties": {
        "pain_points_solved": { "type": "array", "items": { "type": "string" } },
        "competitors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "notes": { "type": "string" },
              "source_url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "audience": {
      "type": "object",
      "required": ["demographics", "language_style"],
      "properties": {
        "demographics": { "type": "string" },
        "language_style": { "type": "string" },
        "platform_behavior": { "type": "string" }
      }
    },
    "creative_landscape": {
      "type": "object",
      "properties": {
        "common_hooks": { "type": "array", "items": { "type": "string" } },
        "common_formats": { "type": "array", "items": { "type": "string" } },
        "typical_duration_seconds": { "type": "number", "minimum": 0 },
        "references": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  },
  "additionalProperties": false
}
