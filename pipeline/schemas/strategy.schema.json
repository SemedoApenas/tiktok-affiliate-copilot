{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiktok-shop-video-ai.local/schemas/strategy.schema.json",
  "title": "Strategy",
  "description": "Saída do strategy-agent: ângulo de venda e oferta/CTA.",
  "type": "object",
  "required": ["schema_version", "project_id", "created_at", "status", "selling_angle", "cta"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "project_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["complete", "error"] },
    "error_reason": { "type": "string" },
    "selling_angle": {
      "type": "object",
      "required": ["type", "rationale"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["pain_point", "desire", "social_proof", "urgency", "novelty", "value"]
        },
        "rationale": {
          "type": "string",
          "description": "Justificativa com base em research.json — não pode ser genérica."
        },
        "based_on_research_fields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Quais campos de research.json sustentam esta escolha."
        }
      }
    },
    "cta": {
      "type": "object",
      "required": ["text", "based_on_product_offer"],
      "properties": {
        "text": { "type": "string" },
        "based_on_product_offer": {
          "type": "boolean",
          "description": "Deve ser true apenas se o CTA usa dados reais de product.json.offer; se não houver oferta real, o CTA deve ser genérico (ex.: 'compre agora')."
        }
      }
    }
  },
  "additionalProperties": false
}
