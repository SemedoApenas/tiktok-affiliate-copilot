{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiktok-shop-video-ai.local/schemas/product.schema.json",
  "title": "Product",
  "description": "Input humano inicial: descreve o produto do TikTok Shop a ser divulgado. Único artefato que não é produzido por um agente.",
  "type": "object",
  "required": ["schema_version", "project_id", "created_at", "status", "product"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["complete"] },
    "product": {
      "type": "object",
      "required": ["name", "category", "description", "price"],
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "price": {
          "type": "object",
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
          }
        },
        "key_features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reference_images": {
          "type": "array",
          "items": { "type": "string", "format": "uri-reference" },
          "description": "Caminhos ou URLs de imagens de referência do produto real, se houver."
        },
        "tiktok_shop_url": { "type": "string", "format": "uri" },
        "offer": {
          "type": "object",
          "description": "Dados comerciais reais fornecidos pelo humano — nunca inventados por um agente.",
          "properties": {
            "discount_code": { "type": ["string", "null"] },
            "promotion_deadline": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
