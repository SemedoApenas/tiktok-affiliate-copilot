{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiktok-shop-video-ai.local/schemas/script.schema.json",
  "title": "Script",
  "description": "Saída do script-agent (após aprovação interna do script-qa-subagent): roteiro em blocos.",
  "type": "object",
  "required": ["schema_version", "project_id", "created_at", "status", "hook", "blocks", "cta_spoken", "total_duration_seconds"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "project_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["draft", "complete", "error"] },
    "qa_cycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Quantos ciclos de reescrita foram necessários (limite MAX 2, ver POLICIES.md)."
    },
    "hook": {
      "type": "object",
      "required": ["text", "duration_seconds"],
      "properties": {
        "text": { "type": "string" },
        "duration_seconds": { "type": "number", "minimum": 0, "maximum": 3 }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "text", "duration_seconds"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "duration_seconds": { "type": "number", "minimum": 0 }
        }
      }
    },
    "cta_spoken": { "type": "string" },
    "total_duration_seconds": { "type": "number", "minimum": 1, "maximum": 90 }
  },
  "additionalProperties": false
}
