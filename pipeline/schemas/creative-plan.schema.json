{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiktok-shop-video-ai.local/schemas/creative-plan.schema.json",
  "title": "Creative Plan",
  "description": "Saída do creative-agent: shot list + prompts/modelos Higgsfield planejados + relatório de continuidade. NÃO contém nenhum resultado de geração — é puramente um plano.",
  "type": "object",
  "required": ["schema_version", "project_id", "created_at", "status", "shots", "continuity"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "project_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["complete", "error"] },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "script_block_order", "description", "duration_seconds", "higgsfield_model", "prompt"],
        "properties": {
          "shot_id": { "type": "string" },
          "script_block_order": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "shot_type": {
            "type": "string",
            "enum": ["product_closeup", "hands_using", "lifestyle", "text_on_screen", "other"]
          },
          "higgsfield_model": {
            "type": "string",
            "description": "Deve ser um modelo real, confirmado contra a skill higgsfield-generate/higgsfield-product-photoshoot."
          },
          "prompt": { "type": "string" },
          "needs_review": { "type": "boolean", "default": false }
        }
      }
    },
    "continuity": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["approved", "rejected"] },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "shot_ids": { "type": "array", "items": { "type": "string" } },
              "issue": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
