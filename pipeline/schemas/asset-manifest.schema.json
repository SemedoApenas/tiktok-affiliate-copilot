{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiktok-shop-video-ai.local/schemas/asset-manifest.schema.json",
  "title": "Asset Manifest",
  "description": "Saída final do higgsfield-production-agent: resultado real da geração (já ocorrida e aprovada) + validação técnica de cada asset.",
  "type": "object",
  "required": ["schema_version", "project_id", "created_at", "status", "assets", "total_credits_spent"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "project_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["complete", "partial_error", "error"] },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "shot_id", "generation_status", "validation_status"],
        "properties": {
          "asset_id": { "type": "string" },
          "shot_id": { "type": "string" },
          "generation_status": { "type": "string", "enum": ["success", "failed"] },
          "generation_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
          "credits_spent": { "type": "number", "minimum": 0 },
          "file_path_or_url": { "type": "string" },
          "validation_status": { "type": "string", "enum": ["valid", "invalid", "not_applicable"] },
          "validation_details": {
            "type": "object",
            "properties": {
              "resolution": { "type": "string" },
              "duration_seconds": { "type": "number" },
              "codec": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "total_credits_spent": { "type": "number", "minimum": 0 }
  },
  "additionalProperties": false
}
